<mujoco model="amazinghand">
  <!--
    AmazingHand (Pollen Robotics) — v4: 실제 메쉬 기반

    v3까지는 부품 STL들이 좌표계를 공유하는지 몰라서 손바닥/손가락을
    박스+캡슐로 뭉뚱그렸다. 이번에 실제로 여러 부품을 겹쳐 렌더링해서
    확인해보니:
      - "손가락 모듈" (finger_frame, gimbal, link, proximal_shell, distal_shell)
        은 전부 하나의 좌표계를 공유한다 -> pos=0으로 겹치면 실제 손가락 모양이 됨
      - "손바닥 모듈" (hand_plate, palm_shell, top_shell)도 서로 좌표계를 공유한다
      - 다만 "손가락 모듈"과 "손바닥 모듈"은 서로 다른(별개) 좌표계다
        (원 CAD에서 서브어셈블리 단위로 좌표계가 나뉘어 있던 것으로 추정)
      -> 그래서 손가락 하나, 손바닥 하나는 각각 실제 형상 그대로 조립되지만,
         "손가락을 손바닥 어디에 얼마나 벌려서 붙이는지"는 여전히 추정값이다
         (조립 사진/실측 대조 권장).

    관절 구조: 실물은 서보 2개의 평행 링크(gimbal+link) 언더액추에이티드
    구조. 여기서는 힌지 2개(외전 z축, 굴곡 x축)로 근사하되, 이번엔
    "실제 메쉬 형상"을 그 위에 그대로 얹어서 시각적으로는 실물과 가깝게 만들었다.
    충돌 형상은 이전과 동일하게 실측 링크 길이(55mm/45mm) 캡슐을 그대로 쓴다.
  -->

  <compiler angle="radian" meshdir="../assets" autolimits="true"/>

  <default>
    <default class="amazinghand">
      <joint damping="0.05" armature="0.001"/>
      <position kp="2.0" forcerange="-1 1"/>
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" rgba="0.08 0.08 0.09 1"/>
      </default>
    </default>
  </default>

  <asset>
    <mesh name="so_arm_interface_mesh" file="so_arm_interface.stl" scale="0.001 0.001 0.001"/>
    <mesh name="hand_plate_mesh" file="hand_plate.stl" scale="0.001 0.001 0.001"/>
    <mesh name="palm_shell_mesh" file="palm_shell.stl" scale="0.001 0.001 0.001"/>
    <mesh name="top_shell_mesh" file="top_shell.stl" scale="0.001 0.001 0.001"/>
    <mesh name="finger_frame_mesh" file="finger_frame_1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="gimbal_mesh" file="gimbal.stl" scale="0.001 0.001 0.001"/>
    <mesh name="link_mesh" file="link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="proximal_shell_mesh" file="proximal_shell.stl" scale="0.001 0.001 0.001"/>
    <mesh name="distal_shell_mesh" file="distal_shell.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <!-- SO-101 gripperframe site에 부착되는 지점 -->
    <body name="ah_wrist_mount" childclass="amazinghand">
      <inertial pos="0 0.01 0" mass="0.02" diaginertia="1e-6 1e-6 1e-6"/>
      <!-- 어댑터 판: 정확한 재중심화 오프셋이 엉뚱한 방향으로 튀어나가서(아래로 분리돼 보임),
           일단 부착 원점에 가깝게 둔다 — 정밀한 위치는 실측/조립 사진 대조 후 조정 필요 -->
      <geom type="mesh" mesh="so_arm_interface_mesh" pos="0 0 0"
            rgba="0.55 0.55 0.6 1"/>

      <!-- 손바닥 모듈: hand_plate + palm_shell + top_shell (셋이 같은 좌표계, pos=0으로 겹침) -->
      <!-- 손바닥 모듈 원점을 palm_shell/hand_plate/top_shell 3개의 실측 공통 중심(-130.9,-45.1,-8.7mm)으로
           재배치. 세 메쉬는 pos="0.1309 0.04505 0.0087"로 이 중심을 body 원점에 맞춘다. -->
      <body name="ah_palm" pos="0 0.02 0.03">
        <inertial pos="0 0.03 0" mass="0.15" diaginertia="0.00012 0.00012 0.00008"/>
        <geom class="visual" type="mesh" mesh="hand_plate_mesh" pos="0.1309 0.04505 0.0087"/>
        <geom class="visual" type="mesh" mesh="palm_shell_mesh" pos="0.1309 0.04505 0.0087"/>
        <geom class="visual" type="mesh" mesh="top_shell_mesh" pos="0.1309 0.04505 0.0087"/>
        <!-- 충돌용 근사 박스 (셸이 concave라 충돌엔 안 씀) -->
        <geom type="box" size="0.028 0.02 0.035" pos="0 0.02 0"
              rgba="0.75 0.75 0.8 0.25" contype="1" conaffinity="1"/>

        <!-- 손가락 4개. 재중심화된 palm 기준 앞쪽 가장자리(Y≈+0.050)에 부착 -->
        <replicate count="4" offset="0.022 0 0" euler="0 0 0">
        <body name="finger_base" pos="-0.033 0.050 0.010">
          <!-- 관절1: 외전 -->
          <joint name="finger_abduct" type="hinge" axis="0 0 1" range="-0.26 0.26"/>
          <inertial pos="0 0 0" mass="0.003" diaginertia="1e-7 1e-7 1e-7"/>
          <geom class="visual" type="mesh" mesh="finger_frame_mesh"/>

          <body name="finger_link">
            <!-- 관절2: 굴곡 -->
            <joint name="finger_flex" type="hinge" axis="1 0 0" range="0 1.4"/>
            <inertial pos="0 0.05 0" mass="0.01" diaginertia="4e-6 4e-6 1e-6"/>

            <!-- 실제 메쉬(짐벌+링크+프록시멀셸+디스탈셸) — 이 넷은 서로 정렬 확인됨 -->
            <geom class="visual" type="mesh" mesh="gimbal_mesh"/>
            <geom class="visual" type="mesh" mesh="link_mesh"/>
            <geom class="visual" type="mesh" mesh="proximal_shell_mesh"/>
            <geom class="visual" type="mesh" mesh="distal_shell_mesh"/>

            <!-- 충돌: 실측 링크 길이(55mm, 45mm) 캡슐 -->
            <geom type="capsule" size="0.007" fromto="0 0 0  0 0.055 0" contype="1" conaffinity="1" group="3" rgba="0.9 0.6 0.1 0.3"/>
            <geom type="capsule" size="0.006" fromto="0 0.050 0  0 0.095 0" contype="1" conaffinity="1" group="3" rgba="0.9 0.3 0.1 0.3"/>

            <site name="fingertip" pos="0 0.095 0" size="0.003"/>
          </body>
        </body>
        </replicate>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position class="amazinghand" name="f0_abduct" joint="finger_abduct" ctrlrange="-0.26 0.26"/>
    <position class="amazinghand" name="f0_flex" joint="finger_flex" ctrlrange="0 1.4"/>
  </actuator>
</mujoco>
