<mujoco model="amazinghand">
  <!--
    AmazingHand (Pollen Robotics) — 단순화 MJCF, v3

    v1 -> v2: "Amazing Hand base.stl"을 손바닥으로 오인했었는데, 실제로 렌더링해보니
      바퀴/지그(jig) 모양이었다 (조립용 거치대로 추정). 부품 STL들이 공통 좌표계를
      공유하지 않아서(각자 로컬 좌표계), 메쉬를 그대로 이어붙이면 위치가 어긋난다.
      -> 손바닥/손가락은 실측 치수 기반의 순수 도형(box/capsule)으로 단순화.

    v2 -> v3: SO-101 <-> AmazingHand를 잇는 진짜 연결 부품인 `SO-ARM_Interface.stl`을
      다시 넣었다. 이건 거치대가 아니라 실제 볼트 구멍이 뚫린 마운팅 브라켓으로,
      단독 렌더링으로 확인함 (bbox 45x49x6mm — 얇은 판형 어댑터). 즉:

        SO-101 gripperframe (스톡 그리퍼 있던 자리)
              |
        SO-ARM_Interface (이 파일의 ah_wrist_mount body, 이 어댑터가 진짜 연결부)
              |
        AmazingHand 손바닥(ah_palm) + 손가락 4개

      스톡 그리퍼(2DoF 평행 그리퍼: gripper 관절 + moving_jaw 바디)는
      build_combined.py가 제거하고, 정확히 그 자리(gripperframe site)에
      이 어댑터를 시작점으로 AmazingHand 전체를 붙인다.

    실측 근거 (STL 바운딩박스, mm, 코드로 직접 측정):
      SO-ARM_Interface: 45 x 49 x 6mm (로컬 좌표 중심 [26.45,-11.5,105.2]mm,
                         geom pos에서 이 중심을 빼서 body 원점에 재배치함)
      proximal 길이 ≈ 55mm, distal 길이 ≈ 45mm
      손가락 단면 폭 ≈ 10~16mm, finger_frame 폭 ≈ 20mm

    단순화 지점:
      실물은 서보 2개의 평행 링크(4절 링크)로 굴곡+외전을 만드는
      언더액추에이티드 구조 -> 여기서는 힌지 2개(외전, 굴곡)로 근사.
      손바닥도 실제 셸 형상 대신 박스로 근사 (약 60x45x15mm, 실측 아님·추정).
      어댑터가 실제로 SO-101 쪽/AmazingHand 쪽 중 어느 면으로 붙는지,
      정확한 회전 방향은 조립 사진 대조 없이는 확정 못 함 — 시각 확인 필요.

    좌표 단위: mesh scale 0.001 로 STL mm 단위를 MuJoCo m 단위로 변환.
  -->

  <compiler angle="radian" meshdir="../assets" autolimits="true"/>

  <default>
    <default class="amazinghand">
      <joint damping="0.05" armature="0.001"/>
      <position kp="2.0" forcerange="-1 1"/>
      <default class="palm_geom">
        <geom type="box" rgba="0.75 0.75 0.8 1"/>
      </default>
    </default>
  </default>

  <asset>
    <mesh name="so_arm_interface_mesh" file="so_arm_interface.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <!-- 이 body 자체가 SO-101의 gripperframe site에 부착되는 지점 -->
    <body name="ah_wrist_mount" childclass="amazinghand">
      <inertial pos="0 0.01 0" mass="0.02" diaginertia="1e-6 1e-6 1e-6"/>
      <!-- 실제 연결 브라켓(SO-ARM_Interface). 메쉬 로컬 좌표 중심을 body 원점으로 재배치 -->
      <geom type="mesh" mesh="so_arm_interface_mesh" pos="-0.02645 0.0115 -0.10520"
            rgba="0.55 0.55 0.6 1"/>

      <body name="ah_palm" pos="0 0.02 0">
        <inertial pos="0 0.025 0" mass="0.15" diaginertia="0.00012 0.00012 0.00008"/>
        <!-- 손바닥: 실측이 안 된 부분이라 도형으로 근사 (60 x 45 x 15mm) -->
        <geom class="palm_geom" size="0.030 0.0225 0.0075" pos="0 0.0225 0"/>

        <!-- 손가락 4개, palm 폭 방향(x)으로 22mm 간격 배치 (finger_frame 실측 폭 20mm 기준) -->
        <replicate count="4" offset="0.022 0 0" euler="0 0 0">
        <body name="finger_base" pos="-0.033 0.045 0">
          <!-- 관절1: 외전(abduction) — 실물 gimbal 2축 관절의 한 축을 근사 -->
          <joint name="finger_abduct" type="hinge" axis="0 0 1" range="-0.26 0.26"/>
          <inertial pos="0 0 0" mass="0.003" diaginertia="1e-7 1e-7 1e-7"/>

          <body name="finger_link" pos="0 0 0">
            <!-- 관절2: 굴곡(flexion) — proximal+distal을 하나의 강체로 근사 -->
            <joint name="finger_flex" type="hinge" axis="1 0 0" range="0 1.4"/>
            <inertial pos="0 0.05 0" mass="0.01" diaginertia="4e-6 4e-6 1e-6"/>

            <!-- 손가락 형상: 실측 링크 길이(55mm, 45mm) 그대로 사용한 캡슐 -->
            <geom type="capsule" size="0.007" fromto="0 0 0  0 0.055 0" rgba="0.9 0.6 0.1 1"/>
            <geom type="capsule" size="0.006" fromto="0 0.050 0  0 0.095 0" rgba="0.9 0.3 0.1 1"/>

            <site name="fingertip" pos="0 0.095 0" size="0.003"/>
          </body>
        </body>
        </replicate>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position class="amazinghand" name="f0_abduct" joint="finger_abduct" ctrlrange="-0.26 0.26"/>
    <position class="amazinghand" name="f0_flex" joint="finger_flex" ctrlrange="0 1.4"/>
  </actuator>
</mujoco>
