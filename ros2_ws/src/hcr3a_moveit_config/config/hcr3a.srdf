<?xml version="1.0" encoding="UTF-8"?>
<robot name="hcr3a">
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>
  <group name="gripper">
    <link name="effector_Link"/>
    <link name="finger1_Link"/>
    <link name="finger2_Link"/>
    <joint name="finger1"/>
    <joint name="finger2"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint_1" value="0.6361"/>
    <joint name="joint_2" value="-1.5965"/>
    <joint name="joint_3" value="-0.1477"/>
    <joint name="joint_4" value="-2.9682"/>
    <joint name="joint_5" value="1.5708"/>
    <joint name="joint_6" value="-0.1493"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="finger1" value="-0.02"/>
    <joint name="finger2" value="0.02"/>
  </group_state>
  <group_state name="close" group="gripper">
    <!-- 4.5 mm past contact with a 4 cm cube (contact at +-0.0055): squeezes without
         letting one finger push the cube far off-center -->
    <joint name="finger1" value="0.01"/>
    <joint name="finger2" value="-0.01"/>
  </group_state>

  <end_effector name="hand" parent_link="tcp" group="gripper" parent_group="arm"/>

  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <!-- adjacent links -->
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="camera_Link" reason="Adjacent"/>
  <disable_collisions link1="camera_Link" link2="forcesensor_Link" reason="Adjacent"/>
  <disable_collisions link1="forcesensor_Link" link2="effector_Link" reason="Adjacent"/>
  <disable_collisions link1="effector_Link" link2="finger1_Link" reason="Adjacent"/>
  <disable_collisions link1="effector_Link" link2="finger2_Link" reason="Adjacent"/>
  <!-- rigidly attached tool stack -->
  <disable_collisions link1="link_6" link2="forcesensor_Link" reason="Never"/>
  <disable_collisions link1="link_6" link2="effector_Link" reason="Never"/>
  <disable_collisions link1="link_6" link2="finger1_Link" reason="Never"/>
  <disable_collisions link1="link_6" link2="finger2_Link" reason="Never"/>
  <disable_collisions link1="camera_Link" link2="effector_Link" reason="Never"/>
  <disable_collisions link1="camera_Link" link2="finger1_Link" reason="Never"/>
  <disable_collisions link1="camera_Link" link2="finger2_Link" reason="Never"/>
  <disable_collisions link1="forcesensor_Link" link2="finger1_Link" reason="Never"/>
  <disable_collisions link1="forcesensor_Link" link2="finger2_Link" reason="Never"/>
  <disable_collisions link1="finger1_Link" link2="finger2_Link" reason="Never"/>
  <!-- RealSense frame from the vendor URDF, rigidly mounted on camera_Link -->
  <disable_collisions link1="camera_link" link2="camera_Link" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="link_6" reason="Never"/>
  <disable_collisions link1="camera_link" link2="forcesensor_Link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="effector_Link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="finger1_Link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="finger2_Link" reason="Never"/>
</robot>
